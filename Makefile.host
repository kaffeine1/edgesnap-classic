# Host lane: build and run the pure-C89 core tests on macOS/Linux.
# The core must stay strict C89 with zero Amiga dependencies.

CC ?= cc
CFLAGS ?= -std=c89 -pedantic -Wall -Wextra -Werror -O2 -Icore -Iinclude
BUILD ?= build/host

TESTS := $(BUILD)/zones_test $(BUILD)/engine_test $(BUILD)/registry_test \
         $(BUILD)/panels_test $(BUILD)/config_test $(BUILD)/gutter_test \
         $(BUILD)/icontrol_test $(BUILD)/config_test_classic \
         $(BUILD)/zones_test_classic \
         $(BUILD)/frame_bits_test $(BUILD)/offscreen_test \
         $(BUILD)/mcp_config_test $(BUILD)/divtokens_test

.PHONY: all test clean

all: $(TESTS)

$(BUILD)/zones_test: core/zones.c core/zones_test.c core/zones.h include/edgesnap_types.h
	mkdir -p "$(BUILD)"
	$(CC) $(CFLAGS) -o "$@" core/zones.c core/zones_test.c

# The zones as the classic lane builds them: a glide whatever the size.
$(BUILD)/zones_test_classic: core/zones.c core/zones_test.c core/zones.h include/edgesnap_types.h
	mkdir -p "$(BUILD)"
	$(CC) $(CFLAGS) -DES_GLIDE_MAX_AREA=0 -o "$@" core/zones.c core/zones_test.c

$(BUILD)/engine_test: core/zones.c core/engine.c core/engine_test.c core/zones.h core/engine.h include/edgesnap_types.h
	mkdir -p "$(BUILD)"
	$(CC) $(CFLAGS) -o "$@" core/zones.c core/engine.c core/engine_test.c

$(BUILD)/registry_test: core/registry.c core/registry_test.c core/registry.h core/zones.h include/edgesnap_types.h
	mkdir -p "$(BUILD)"
	$(CC) $(CFLAGS) -o "$@" core/registry.c core/registry_test.c

$(BUILD)/panels_test: core/panels.c core/panels_test.c core/panels.h core/zones.h include/edgesnap_types.h
	mkdir -p "$(BUILD)"
	$(CC) $(CFLAGS) -o "$@" core/panels.c core/panels_test.c

$(BUILD)/config_test: core/config.c core/config_test.c core/config.h core/engine.h core/panels.h core/zones.h include/edgesnap_types.h
	mkdir -p "$(BUILD)"
	$(CC) $(CFLAGS) -o "$@" core/config.c core/engine.c core/zones.c core/config_test.c

$(BUILD)/gutter_test: core/gutter.c core/registry.c core/zones.c core/gutter_test.c core/gutter.h core/registry.h core/zones.h include/edgesnap_types.h
	mkdir -p "$(BUILD)"
	$(CC) $(CFLAGS) -o "$@" core/gutter.c core/registry.c core/zones.c core/gutter_test.c

# The settings as the classic lane builds them: the glide off as they
# come. Every other test of the file must hold there as well.
$(BUILD)/config_test_classic: core/config.c core/config_test.c core/config.h core/engine.h core/panels.h core/zones.h include/edgesnap_types.h
	mkdir -p "$(BUILD)"
	$(CC) $(CFLAGS) -DES_CONFIG_ANIMATE_DEFAULT=0 -o "$@" core/config.c core/engine.c core/zones.c core/config_test.c

# The preview frame's pixels (commodity/frame_bits.c): pure C, so the
# masked XOR is held to its promises here before any screen sees it.
$(BUILD)/frame_bits_test: commodity/frame_bits.c commodity/frame_bits_test.c commodity/frame_bits.h
	mkdir -p "$(BUILD)"
	$(CC) $(CFLAGS) -Icommodity -o "$@" commodity/frame_bits.c commodity/frame_bits_test.c

# MCP's two lines (commodity/mcp_config.c): the text EdgeSnap writes into
# ENV: on AmiKit, held to every byte here first.
$(BUILD)/mcp_config_test: commodity/mcp_config.c commodity/mcp_config_test.c commodity/mcp_config.h
	mkdir -p "$(BUILD)"
	$(CC) $(CFLAGS) -Icommodity -o "$@" commodity/mcp_config.c commodity/mcp_config_test.c

$(BUILD)/icontrol_test: core/icontrol.c core/icontrol_test.c core/icontrol.h
	mkdir -p "$(BUILD)"
	$(CC) $(CFLAGS) -o "$@" core/icontrol.c core/icontrol_test.c

$(BUILD)/offscreen_test: core/offscreen.c core/offscreen_test.c core/offscreen.h
	mkdir -p "$(BUILD)"
	$(CC) $(CFLAGS) -o "$@" core/offscreen.c core/offscreen_test.c

$(BUILD)/divtokens_test: core/divtokens.c core/divtokens_test.c core/divtokens.h core/gutter.h core/registry.h core/zones.h include/edgesnap_types.h
	mkdir -p "$(BUILD)"
	$(CC) $(CFLAGS) -o "$@" core/divtokens.c core/divtokens_test.c

test: $(TESTS)
	./$(BUILD)/zones_test
	./$(BUILD)/engine_test
	./$(BUILD)/registry_test
	./$(BUILD)/panels_test
	./$(BUILD)/config_test
	./$(BUILD)/gutter_test
	./$(BUILD)/icontrol_test
	./$(BUILD)/config_test_classic
	./$(BUILD)/zones_test_classic
	./$(BUILD)/frame_bits_test
	./$(BUILD)/offscreen_test
	./$(BUILD)/mcp_config_test
	./$(BUILD)/divtokens_test

clean:
	rm -f $(TESTS)
